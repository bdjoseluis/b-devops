# Copia este archivo como terraform.tfvars y rellena tus datos
# OCI → clic en tu avatar (arriba derecha) → "My Profile" → API Keys

tenancy_ocid     = "ocid1.tenancy.oc1..xxxxx"
user_ocid        = "ocid1.user.oc1..xxxxx"
fingerprint      = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "eu-frankfurt-1"
compartment_id   = "ocid1.tenancy.oc1..xxxxx"   # igual que tenancy_ocid para root

# Cloudflare → Zero Trust → Tunnels → tu túnel → token
cloudflare_tunnel_token = "eyJ..."
