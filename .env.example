# ─── AURA OPS — Variables de entorno ───────────────────────────
# Copia este archivo como .env y rellena los valores

# ─── Base de datos ──────────────────────────────────────────────
POSTGRES_USER=aura
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=aura_ops

# ─── ClickHouse ─────────────────────────────────────────────────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme_clickhouse

# ─── n8n ────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n
N8N_ENCRYPTION_KEY=changeme_32_char_random_string_here

# ─── Backend ────────────────────────────────────────────────────
SECRET_KEY=changeme_backend_secret

# ─── APIs OSINT ─────────────────────────────────────────────────
GEMINI_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=

# ─── Integraciones DevOps ───────────────────────────────────────
VERCEL_TOKEN=
SUPABASE_TOKEN=
