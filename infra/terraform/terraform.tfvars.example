# ─── COPIA ESTE ARCHIVO A terraform.tfvars Y RELLENA LOS VALORES ─────────────
# terraform.tfvars está en .gitignore — NUNCA commitees tokens reales

hcloud_token   = "TU_TOKEN_HETZNER_AQUI"
server_type    = "cx32"
location       = "nbg1"
server_name    = "bdev-vps"
image          = "ubuntu-24.04"
backups_enabled = false

# Pega el contenido de tu ~/.ssh/id_rsa.pub (o id_ed25519.pub)
ssh_public_key = "ssh-rsa AAAA... tu@email.com"
