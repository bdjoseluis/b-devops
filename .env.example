# ═══════════════════════════════════════════════════════════════════════════════
# B-DEVOPS — Plantilla de variables de entorno
# Copia: cp .env.example .env  →  rellena los valores
# NUNCA subas .env al repo (está en .gitignore)
# ═══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=bdev
POSTGRES_PASSWORD=CAMBIA_ESTO
POSTGRES_DB=bdev_ops

# ── Backend ───────────────────────────────────────────────────────────────────
# Genera: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_VALOR_ALEATORIO

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIA_ESTO

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CAMBIA_ESTO

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── WireGuard VPN ─────────────────────────────────────────────────────────────
WG_SERVER_HOST=TU_IP_PUBLICA
# Genera bcrypt en: https://bcrypt.online/ (cost factor 10, usar $$ en YAML)
WG_PASSWORD_HASH=$$2y$$10$$HASH_AQUI

# ── APIs OSINT ────────────────────────────────────────────────────────────────
# Si defines estas variables, GANAN sobre config.json (config_manager las lee
# del entorno primero, con config.json como fallback). Así los secretos pueden
# vivir sólo aquí, fuera del repo.
GEMINI_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
GROQ_API_KEY=
HUNTER_API_KEY=
SECURITYTRAILS_API_KEY=
HIBP_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
GOOGLE_PLACES_API_KEY=
NOTION_TOKEN=

# ── Integraciones DevOps ──────────────────────────────────────────────────────
VERCEL_TOKEN=
SUPABASE_TOKEN=

# ── Auth / SSH / SMTP (override de config.json) ───────────────────────────────
# Definidas aquí ganan sobre config.json. Recomendado para sacar contraseñas
# del config.json (que aunque está en .gitignore, vive en claro en disco).
AUTH_PASSWORD=
ADMIN_PIN=
KALI_SSH_PASSWORD=
SMTP_PASSWORD=

# ── crm-deploy (script de deploy del CRM al VPS) ──────────────────────────────
# crm-deploy/deploy.py los lee del entorno (ya no hardcodeados)
VPS_ROOT_PASS=
ADMIN_PASS=

# ── Outreach Engine ───────────────────────────────────────────────────────────
# Clave compartida para integrar formularios externos
INTEGRATION_KEY=bdev_int_key_2026
# Máximo emails de outreach por día (protege la cuenta Gmail)
OUTREACH_DAILY_LIMIT=50
# Contraseña admin inicial (si config.json no tiene una — para primer arranque)
ADMIN_PASSWORD=

# ── Devesan (PsicoSalud Devesan) ─────────────────────────────────────────────
# Contraseña admin para el panel de Dolores (devesan.bdev.qzz.io/admin-login)
DEVESAN_ADMIN_PASSWORD=
