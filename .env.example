# ─── B-DEVOPS — Variables de entorno ───────────────────────────
# Copia este archivo como .env y ajusta los valores

# ─── Base de datos ──────────────────────────────────────────────
POSTGRES_USER=bdev
POSTGRES_PASSWORD=REDACTED
POSTGRES_DB=bdev_ops

# ─── ClickHouse ─────────────────────────────────────────────────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=REDACTED

# ─── n8n ────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=REDACTED
N8N_ENCRYPTION_KEY=bdevops_n8n_encryption_key_32chars

# ─── Backend ────────────────────────────────────────────────────
SECRET_KEY=bdevops_jwt_secret_key_changeme

# ─── Grafana ────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REDACTED

# ─── WireGuard VPN ──────────────────────────────────────────────
# WG_SERVER_HOST: IP pública o dominio que resuelve a tu máquina (sin Cloudflare)
WG_SERVER_HOST=0.0.0.0
# WG_PASSWORD_HASH: bcrypt de tu contraseña — genera en https://bcrypt.online/
# Contraseña por defecto: REDACTED
WG_PASSWORD_HASH=$$2y$$10$$K3gGl7Nm2Mb2opUc9ILr4.9HJaZ.jhUNNXoRPxzAy3FpN.ZaJuuEy

# ─── APIs OSINT ─────────────────────────────────────────────────
GEMINI_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=

# ─── Integraciones DevOps ───────────────────────────────────────
VERCEL_TOKEN=
SUPABASE_TOKEN=
